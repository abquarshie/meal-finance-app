// Cashew's money tables, exactly as the Python app creates them (core/schema.py, ensure_schema).
// Prisma only reads and writes rows here. The Python side still owns the table definitions, and the
// kitchen tables live in the separate "meals" schema, which Prisma doesn't touch.
//
// Never run `prisma migrate` or `prisma db push` against Cashew's database: they would try to make the
// database match this file, and this file doesn't describe the kitchen or the CHECK constraints.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Transaction {
  id         Int       @id @default(autoincrement())
  date       DateTime  @db.Date
  type       String    @db.VarChar(10) // Income, Expense or Transfer
  category   String    @db.VarChar(50)
  amount     Decimal   @db.Decimal(10, 2)
  note       String?
  member     String?   @db.VarChar(50)
  account    String?   @db.VarChar(50)
  toAccount  String?   @map("to_account") @db.VarChar(50)
  createdBy  String?   @map("created_by") @db.VarChar(30)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([date(sort: Desc), id(sort: Desc)], map: "transactions_date_idx")
  @@index([category, amount], map: "transactions_cat_amount_idx")
  @@map("transactions")
}

model Budget {
  category     String  @id @db.VarChar(50) // a group name (Food) or a category name
  monthlyLimit Decimal @map("monthly_limit") @db.Decimal(10, 2)

  @@map("budgets")
}

model Goal {
  id            Int                @id @default(autoincrement())
  name          String             @db.VarChar(80)
  target        Decimal            @db.Decimal(12, 2)
  deadline      DateTime?          @db.Date
  contributions GoalContribution[]

  @@map("goals")
}

model GoalContribution {
  id        Int      @id @default(autoincrement())
  goalId    Int      @map("goal_id")
  date      DateTime @db.Date
  amount    Decimal  @db.Decimal(12, 2)
  note      String?
  createdBy String?  @map("created_by") @db.VarChar(30)
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId], map: "goal_contributions_goal_idx")
  @@map("goal_contributions")
}

model Category {
  id        Int    @id @default(autoincrement())
  name      String @unique @db.VarChar(50)
  groupName String @map("group_name") @db.VarChar(60)
  kind      String @db.VarChar(10)

  @@map("categories")
}

model Account {
  id             Int      @id @default(autoincrement())
  name           String   @unique @db.VarChar(50)
  openingBalance Decimal  @default(0) @map("opening_balance") @db.Decimal(12, 2)
  spendable      Boolean? @default(true) // "everyday money"; savings accounts are false

  @@map("accounts")
}

model RecurringRule {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(80)
  type      String    @db.VarChar(10)
  amount    Decimal   @db.Decimal(10, 2)
  fee       Decimal?  @db.Decimal(10, 2)
  category  String    @db.VarChar(50)
  account   String    @db.VarChar(50)
  toAccount String?   @map("to_account") @db.VarChar(50)
  member    String?   @db.VarChar(50)
  note      String?
  frequency String    @db.VarChar(20)
  startDate DateTime  @map("start_date") @db.Date
  nextDate  DateTime  @map("next_date") @db.Date
  runCount  Int       @default(0) @map("run_count")
  endDate   DateTime? @map("end_date") @db.Date
  active    Boolean   @default(true)
  lastRun   DateTime? @map("last_run") @db.Date

  @@map("recurring_rules")
}

model AppMeta {
  key   String  @id @db.VarChar(50)
  value String?

  @@map("app_meta")
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(30) // always lower case
  displayName  String    @map("display_name") @db.VarChar(50)
  passwordHash String    @map("password_hash") // pbkdf2_sha256$rounds$salt$hash, shared with the Python app
  isOwner      Boolean   @default(false) @map("is_owner")
  failedLogins Int       @default(0) @map("failed_logins")
  lockedUntil  DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastLogin    DateTime? @map("last_login") @db.Timestamptz(6)
  sessions     Session[]

  @@map("users")
}

model Session {
  tokenHash String   @id @map("token_hash") @db.Char(64) // sha256 of the cookie's token, never the token
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_user_idx")
  @@map("sessions")
}
